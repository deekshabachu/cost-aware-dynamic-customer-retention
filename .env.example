# Generate a fresh random value for each deployment; keep it private.
AUTH_SECRET_KEY=replace-with-a-strong-random-local-secret
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD_HASH=

# Local Vite dev server. Add only trusted origins, comma-separated if needed.
FRONTEND_ORIGINS=http://localhost:5173

# Existing local SQLite default.
DATABASE_URL=sqlite:///./data/customer_retention.db

# Optional local checkout assumptions; see docs/checkout-pricing.md.
DEMO_SHIPPING_FEE=40.00
DEMO_TAX_RATE=0.05
RETENTION_OFFER_VALIDITY_DAYS=7
